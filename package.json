{
  "name": "jufexk",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.20.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "prototype": "vite",
    "build": "vite build",
    "test": "pnpm run test:workers && pnpm run test:static",
    "test:workers": "vitest run --no-file-parallelism --exclude test/global-search-prototype.test.ts --exclude test/prototype-local-seed.test.ts",
    "test:static": "vitest run --config vitest.node.config.ts --exclude test/page-atlas.node.test.ts && vitest run --config vitest.secrets.config.ts",
    "test:browser": "playwright test",
    "test:browser:smoke": "playwright test --project=chromium --grep @pr-smoke",
    "test:prototype": "vitest run --no-file-parallelism test/global-search-prototype.test.ts test/prototype-local-seed.test.ts && vitest run --config vitest.node.config.ts test/page-atlas.node.test.ts",
    "test:prototype:browser": "playwright test --config playwright.prototype.config.ts test/browser/global-search.browser.test.ts test/browser/review-recognition.browser.test.ts",
    "timing:prod-public": "node scripts/prod-public-timing.mjs",
    "build:catalog-userscript": "node scripts/catalog-baseline/build-userscript.mjs",
    "build:program-plan-userscript": "node scripts/program-plan/build-userscript.mjs",
    "program-plan": "tsx scripts/program-plan/cli.ts",
    "validate:catalog-capture": "tsx scripts/catalog-baseline/validate-capture.ts",
    "audit:catalog-pilot": "tsx scripts/catalog-baseline/audit-pilot.ts",
    "audit:catalog-full": "tsx scripts/catalog-baseline/audit-full.ts",
    "audit:pe-mapping": "tsx scripts/pe-mapping-audit/run.ts",
    "closeout:pe-queue": "tsx scripts/pe-queue-closeout/run.ts",
    "check:pe-alias-equivalence": "tsx scripts/pe-alias-equivalence/run.ts",
    "observe:pe-alias": "tsx scripts/pe-alias-observe/run.ts",
    "catalog-baseline": "tsx scripts/catalog-baseline/cli.ts",
    "jwxt-sync": "tsx scripts/jwxt-sync/run.ts",
    "cta-sync": "tsx scripts/cta-sync/run.ts",
    "cta-sync:webp": "tsx scripts/cta-sync/to-webp.ts",
    "cta-sync:apply-local": "python3 scripts/cta-sync/apply-local.py",
    "cta-sync:apply-remote": "tsx scripts/cta-sync/apply-remote.ts --remote --apply",
    "teacher-dept-backfill": "tsx scripts/teacher-department-backfill/run.ts",
    "teacher-dept-backfill:apply-remote": "tsx scripts/teacher-department-backfill/apply-remote.ts --remote --apply",
    "jwxt-collect": "tsx scripts/jwxt-collector/run.ts",
    "jwxt-cookie-capture": "tsx scripts/jwxt-cookie-capture.ts",
    "deploy": "pnpm run build && wrangler deploy",
    "types": "wrangler types",
    "check:static": "wrangler types && tsc --noEmit && pnpm run test:static && vite build && wrangler deploy --dry-run --env=\"\"",
    "check": "wrangler types && tsc --noEmit && pnpm test && pnpm run test:browser && vite build && wrangler deploy --dry-run --env=\"\"",
    "db:local": "wrangler d1 migrations apply jufexk --local",
    "db:seed-preview": "wrangler d1 execute jufexk --local --file=scripts/prototype-local-seed.sql",
    "db:export-remote": "mkdir -p .local-data && wrangler d1 export jufexk --remote --output=.local-data/remote-export.sql -y",
    "db:import-remote-local": "python3 scripts/import-remote-export-local.py",
    "benchmark:catalog-fts": "bash scripts/d1/benchmark-catalog-fts.sh",
    "db:create-preview": "bash scripts/d1/create-preview-db.sh",
    "db:clone-preview": "bash scripts/d1/clone-preview.sh",
    "catalog-relations:v10": "tsx scripts/catalog-relation-additions/publish-v10.ts",
    "historical-import:v5": "tsx scripts/historical-import/publish-v5.ts",
    "secrets:sync-local": "tsx scripts/secrets/sync-local.ts",
    "check:migrations": "node scripts/check-migrations.mjs"
  },
  "dependencies": {
    "@gravity-ui/icons": "^2.21.0",
    "@heroui/react": "^3.2.4",
    "@heroui/styles": "^3.2.4",
    "dompurify": "^3.4.15",
    "fuse.js": "7.5.0",
    "hono": "4.13.7",
    "pinyin-pro": "^3.29.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "0.28.2",
    "iconv-lite": "^0.7.3",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.125.0"
  }
}
